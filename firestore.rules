rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /flashcardUsers/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'snapshot',
          'updatedAt',
          'updatedAtISO'
        ])
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.version == 1
        && request.resource.data.snapshot.entries is map
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAtISO is string;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

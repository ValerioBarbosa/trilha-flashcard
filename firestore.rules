rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /flashcardUsers/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'snapshotVersion',
          'chunkCount',
          'updatedAt',
          'updatedAtISO'
        ])
        && request.resource.data.snapshotVersion == 2
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 500
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAtISO is string;

      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.ownerUid == userId
          && request.resource.data.keys().hasOnly([
            'ownerUid',
            'index',
            'data',
            'updatedAtISO'
          ])
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.data is string
          && request.resource.data.updatedAtISO is string;

        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
